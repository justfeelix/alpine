__pycache__/
*.pyc
.venv/
.pytest_cache/
.env

# Warehouse — rebuildable from source, and large
data/warehouse.duckdb
data/warehouse.duckdb.wal

# API response cache
data/cache/

# snow.csv is 26 MB — see README for how to obtain it
data/raw/ski-resort-data/snow.csv

# Model output. The .joblib is a 1 MB binary rebuildable in seconds by `make model`;
# metrics.json is the scorecard and IS tracked, so a diff shows how the numbers moved.
models/*.joblib

# NOTE: site/data.json is deliberately NOT ignored. It is what GitHub Pages deploys, and
# committing it makes each published snapshot a reviewable diff.

# dbt — target/ is build output, dbt_packages/ is vendored deps (dbt deps)
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Airflow runtime state. AIRFLOW_HOME points at airflow/, so Airflow generates its
# metadata database, config and logs in there. Only dags/ is source; everything else is
# regenerated by `airflow db migrate` and must never be committed — airflow.db in
# particular accumulates every task instance, XCom value and connection you create.
airflow/airflow.db
airflow/airflow.cfg
airflow/logs/
airflow/*.pid
airflow/*.err
airflow/*.out
airflow/simple_auth_manager_passwords.json.generated
.venv-airflow/
